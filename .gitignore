# Environment & secrets
.env
credentials.json
token.json
.clineignore

# Intermediate / temp files (always regenerated, never committed)
.tmp/
.idea/
tmp/
!.tmp/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# Node / npm (installed by tooling, not needed for browser app)
node_modules/
package-lock.json

# OS
.DS_Store
Thumbs.db

# Editor / IDE (local to one machine, not part of the app)
*.code-workspace
.vscode/

# Scripts that contact the Traveller wiki (API or scraping). Kept local only, so
# nothing in the repo can hit the wiki. The offline wiki_parse.py / wiki_build.py stay.
utilities/scrape_wiki.py
utilities/wiki_fetch.py
